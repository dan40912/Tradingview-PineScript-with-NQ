pnlTxt(x) => str.tostring(x, "+$#,##0;−$#,##0")
// 清楚訊號：BUY／SELL＋策略＋進場、TP、SL＋原因（計畫外的點顯示「觀察」灰色）
bsTxt(isBuy, inP, name, e, why) => (inP ? (isBuy ? "BUY  " : "SELL  ") : "觀察（不做）") + name + "\n進 " + fmt(e) + "｜TP " + fmt(isBuy ? e + TP1 : e - TP1) + "｜SL " + fmt(isBuy ? e - SL : e + SL) + "\n" + why
bsCol(isBuy, inP) => inP ? (isBuy ? color.new(color.green, 0) : color.new(color.red, 0)) : color.new(color.gray, 30)
resMark(out) => str.startswith(out, "止盈") ? "\n→ ✓ 止盈 +$1,052" : str.startswith(out, "止損") ? "\n→ ✗ 止損 −$2,948" : "\n→ ⏱ " + out
var string i2Base = ""
var array<string> refBase = array.new<string>(4, "")
var array<string> asBase  = array.new<string>(2, "")
var array<string> xBase   = array.new<string>(2, "")
// 圖上標籤／方框依交易日登記，只保留最近 keepDays 天（舊的刪掉，避免疊在一起）
var array<int>   dayQ    = array.new<int>()
var array<label> keepLbl = array.new<label>()
var array<int>   keepLD  = array.new<int>()
var array<box>   keepBox = array.new<box>()
var array<int>   keepBD  = array.new<int>()
regL(l, d) =>
    array.push(keepLbl, l)
    array.push(keepLD, d)
    l
regB(b, d) =>
    array.push(keepBox, b)
    array.push(keepBD, d)
    b
// Pine v5 的 and／or 兩邊都會算，所以先檢查陣列大小再讀
pruneDays(d) =>
    nq = array.size(dayQ)
    if nq == 0
        array.push(dayQ, d)
    else if array.get(dayQ, nq - 1) != d
        array.push(dayQ, d)
    while array.size(dayQ) > keepDays
        old = array.shift(dayQ)
        while array.size(keepLD) > 0
            if array.get(keepLD, 0) > old
                break
            array.shift(keepLD)
            label.delete(array.shift(keepLbl))
        while array.size(keepBD) > 0
            if array.get(keepBD, 0) > old
                break
            array.shift(keepBD)
            box.delete(array.shift(keepBox))
// 參考點（只顯示，不是規則）：0 前高假突破→空、1 前低假突破→多、2 區邊回歸→空、3 區邊回歸→多；每天各最多一次
