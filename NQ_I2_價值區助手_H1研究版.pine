refName(r) => r == 0 ? "前高假突破 空" : r == 1 ? "前低假突破 多" : r == 2 ? "區邊回歸 空" : "區邊回歸 多"
refShort(r) => r == 0 ? "前高空" : r == 1 ? "前低多" : r == 2 ? "區邊空" : "區邊多"
// 歷史（2024-01～2026-10，+55／−145、$48 成本；每筆平均，括號為 2024｜2025｜2026）
refHist(r, outDay) => r == 0 ? (outDay ? "歷史：開在區外的日子每筆 +$74（154 筆；+167｜+59｜−19）" : "歷史：開在區內的日子每筆 +$186（72 筆；+60｜+261｜+261）") :
                      r == 1 ? "歷史：每筆 +$134（169 筆；+197｜+202｜−3）" :
                      r == 2 ? "歷史：每筆 −$58（57 筆；+175｜+51｜−585）" : "歷史：每筆 −$299（54 筆；−143｜−546｜−138）"

