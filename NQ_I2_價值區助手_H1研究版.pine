adr10Now() =>
    n = array.size(dRanges)
    float out = na
    if n >= 10
        sr = 0.0
        for k = 0 to 9
            sr += array.get(dRanges, n - 1 - k)
        out := sr / 10
    out
shockOf(arr) =>
    n = array.size(arr)
    mx = 0.0
    if n >= 6
        for k = 0 to n - 6
            mx := math.max(mx, math.abs(array.get(arr, k + 5) - array.get(arr, k)))
    mx
gateWhy() => shockNow >= swanTh ? "最近 30 分鐘暴衝 " + str.tostring(shockNow, "#,##0") + " 點" : planPnl - FULL_SL * (planOpen + 1) < LOSS_CAP ? "今天再虧一筆會超過 −$3,000" : ""
// 用成交量分布算價值區（和 I2 相同算法，ES 也用 5 點一格）
vaCalc(map<int, float> pr) =>
    keys = map.keys(pr)
    array.sort(keys, order.ascending)
    kMin = array.get(keys, 0)
    kMax = array.get(keys, array.size(keys) - 1)
    total = 0.0
    poc = kMin
    pocV = -1.0
    for i = 0 to array.size(keys) - 1
        k = array.get(keys, i)
        v = map.get(pr, k)
        total += v
        if v > pocV
            pocV := v
            poc := k
    lo = poc
    hi = poc
    acc = pocV
    while acc < VA_FRAC * total and (lo > kMin or hi < kMax)
        lv = map.contains(pr, lo - 1) ? map.get(pr, lo - 1) : -1.0
        hv = map.contains(pr, hi + 1) ? map.get(pr, hi + 1) : -1.0
        if hv > lv
            hi += 1
            acc += math.max(0.0, hv)
        else
            lo -= 1
            acc += math.max(0.0, lv)
    [lo * BIN, poc * BIN, (hi + 1) * BIN]

// 新進場點（docs/22、23）：0 亞洲 VAL 多 ES、1 早盤夜低多 ES（美盤早上掃夜盤低點後收回，波動 ≥ 1.2 倍）
var array<int>    xSt   = array.new<int>(2, 0)
var array<int>    xSigT = array.new<int>(2, 0)
var array<float>  xE    = array.new<float>(2, na)
var array<label>  xLbl  = array.new<label>(2, na)
var array<box>    xTp   = array.new<box>(2, na)
var array<box>    xSlB  = array.new<box>(2, na)
var array<string> xTxt  = array.new<string>(2, "")
var array<bool>   xInP  = array.new<bool>(2, false)
var int    xDay  = 0
var string xLast = "—"
xName(k) => k == 0 ? "亞洲VAL多 ES" : "早盤夜低多 ES"
xHist(k) => k == 0 ? "歷史每筆（ES 同步）：2024 +$407（15 筆、80%）｜2025 +$222（33、70%）｜2026-1～9 +$553（39、79%）｜10/1～11/11 +$562（4、75%）" :
                     "歷史每筆（ES 同步、波動 ≥1.2 倍）：2024 +$383（9 筆、67%）｜2025 +$128（24、75%）｜2026-1～9 +$539（32、84%）｜10/1～11/11 +$1,052（4、100%）"

// ES 同步確認：ES 自己的前一日盤中高／低、美東 18:00 起的最低價、亞洲多訊號
[eT, eH, eL, eC, eV] = request.security_lower_tf(esSym, "1", [time, high, low, close, volume])
var float esSesHi = na
var float esSesLo = na
var bool  esInRth = false
var float esPdl   = na
var float esAsLo  = na
var int   esDay   = 0
var int   esSigT  = 0        // ES 亞洲多訊號那根 1 分K 的時間；0＝今晚還沒有
var map<int, float> esProf = map.new<int, float>()
var float esVAL    = na       // ES 前一日價值區下緣
var int   esVaSigT = 0        // ES 亞洲 VAL 多訊號時間
var float esOnLo   = na       // ES 美東 18:00～09:29 最低
var float esRthLo  = na       // ES 美股盤中（09:30 起）最低
var int   esOnSigT = 0        // ES 早盤夜低多訊號時間
nE = array.size(eT)
if nE > 0
    for j = 0 to nE - 1
        tE = array.get(eT, j)
        hE = array.get(eH, j)
        lE = array.get(eL, j)
        cE = array.get(eC, j)
        vE = array.get(eV, j)
        mE = minOf(tE)
        dE = ymdOf(tE)
        okE1 = barstate.isconfirmed or j < nE - 1 or timenow >= tE + 60000
        rthE = mE >= 570 and mE <= 959
        if okE1
            if esInRth and not rthE
                esPdl := esSesLo
                esInRth := false
                if map.size(esProf) > 0
                    [eVal, ePoc, eVah] = vaCalc(esProf)
                    esVAL := eVal
                map.clear(esProf)
            if rthE
                aE = int(math.floor(lE / BIN))
                bE = int(math.floor(hE / BIN))
                for k = aE to bE
                    map.put(esProf, k, (map.contains(esProf, k) ? map.get(esProf, k) : 0.0) + vE / (bE - aE + 1))
                if mE == 570 or na(esRthLo)
                    esRthLo := lE
                else
                    esRthLo := math.min(esRthLo, lE)
            if rthE
                if not esInRth
                    esSesHi := hE
                    esSesLo := lE
                    esInRth := true
                else
                    esSesHi := math.max(esSesHi, hE)
                    esSesLo := math.min(esSesLo, lE)
            if mE >= 1080 and esDay != dE
                esDay := dE
                esAsLo := lE
                esSigT := 0
                esVaSigT := 0
                esOnLo := lE
                esOnSigT := 0
                esRthLo := na
            else
                if (mE >= 1080 or mE <= 179) and not na(esAsLo)
                    esAsLo := math.min(esAsLo, lE)
                if (mE >= 1080 or mE < 570) and not na(esOnLo)
                    esOnLo := math.min(esOnLo, lE)
            if mE % 5 == 4 and (mE >= 1084 or mE <= 119) and esVaSigT == 0 and not na(esVAL) and not na(esAsLo)
                if esAsLo < esVAL and cE > esVAL
                    esVaSigT := tE
            // ES 早盤夜低多：09:34～11:29 的 5 分K（進場 09:35～11:30，09:58～10:02 不進場）
            eiE = mE + 1 - 570
            if mE % 5 == 4 and mE >= 574 and mE <= 689 and not (eiE >= 28 and eiE <= 32) and esOnSigT == 0 and not na(esOnLo) and not na(esRthLo)
                if esRthLo < esOnLo and cE > esOnLo
                    esOnSigT := tE
            if mE % 5 == 4 and (mE >= 1084 or mE <= 119) and esSigT == 0 and not na(esPdl) and not na(esAsLo)
                if esAsLo < esPdl and cE > esPdl
                    esSigT := tE

brk = false
n1 = array.size(aT)
if n1 > 0
    for j = 0 to n1 - 1
        t1   = array.get(aT, j)
        o1   = array.get(aO, j)
        h1   = array.get(aH, j)
        l1   = array.get(aL, j)
        c1   = array.get(aC, j)
        v1   = array.get(aV, j)
        m1   = minOf(t1)
        d1   = ymdOf(t1)
        rth1 = m1 >= 570 and m1 <= 959
        i1   = m1 - 570
        closed1 = barstate.isconfirmed or j < n1 - 1 or timenow >= t1 + 60000
        // 局勢：盤中 VWAP 用到前一分鐘為止；暴衝幅度用前 30 根 1 分K
        if m1 == 570
            pvSum := 0.0
            vSum := 0.0
        vwPrev = vSum > 0 ? pvSum / vSum : na
        shockNow := shockOf(recentC)
        // 5 分K：新的 5 分鐘開始時，先把上一根收掉並更新指標（只用已收盤的 1 分K）
        bk = (d1 % 100000) * 1000 + int(m1 / 5)   // 只要相鄰的 5 分鐘能分辨就好；用日期後 5 碼避免整數太大
        if not na(b5Key) and bk != b5Key and not na(b5C)
            tr5 = na(pc5) ? b5H - b5L : math.max(b5H - b5L, math.abs(b5H - pc5), math.abs(b5L - pc5))
            upm = na(ph5) ? na : b5H - ph5
            dnm = na(pl5) ? na : pl5 - b5L
            pdm = not na(upm) and upm > dnm and upm > 0 ? upm : 0.0
            ndm = not na(dnm) and dnm > upm and dnm > 0 ? dnm : 0.0
            atr5 := na(atr5) ? tr5 : atr5 + (tr5 - atr5) / 14
            pdmS := na(pdmS) ? pdm : pdmS + (pdm - pdmS) / 14
            ndmS := na(ndmS) ? ndm : ndmS + (ndm - ndmS) / 14
            e20 := na(e20) ? b5C : e20 + (b5C - e20) * 2 / 21
            e12 := na(e12) ? b5C : e12 + (b5C - e12) * 2 / 13
            e26 := na(e26) ? b5C : e26 + (b5C - e26) * 2 / 27
            macd = e12 - e26
            mSig := na(mSig) ? macd : mSig + (macd - mSig) * 2 / 10
            array.push(e20h, e20)
            if array.size(e20h) > 7
                array.shift(e20h)
            kSlope := array.size(e20h) == 7 and atr5 > 0 ? (e20 - array.get(e20h, 0)) / atr5 : na
            kDi := atr5 > 0 ? 100 * (pdmS - ndmS) / atr5 : na
            kMac := atr5 > 0 ? (macd - mSig) / atr5 : na
            pc5 := b5C
            ph5 := b5H
            pl5 := b5L
            b5C := na
        if closed1
            if bk != b5Key or na(b5C)
                b5Key := bk
                b5H := h1
                b5L := l1
            else
                b5H := math.max(b5H, h1)
                b5L := math.min(b5L, l1)
            b5C := c1

        // 前一個盤中時段結束 → 算出價值區
        if not na(profDate) and (not rth1 or d1 != profDate) and map.size(prof) > 0
            keys = map.keys(prof)
            array.sort(keys, order.ascending)
            kMin = array.get(keys, 0)
            kMax = array.get(keys, array.size(keys) - 1)
            total = 0.0
            poc = kMin
            pocV = -1.0
            for i = 0 to array.size(keys) - 1
                k = array.get(keys, i)
                v = map.get(prof, k)
                total += v
                if v > pocV                 // 由低往高掃，同量保留較低的格
                    pocV := v
                    poc := k
            lo = poc
            hi = poc
            acc = pocV
            while acc < VA_FRAC * total and (lo > kMin or hi < kMax)
                lv = map.contains(prof, lo - 1) ? map.get(prof, lo - 1) : -1.0
                hv = map.contains(prof, hi + 1) ? map.get(prof, hi + 1) : -1.0
                if hv > lv                  // 同量時先往下擴張
                    hi += 1
                    acc += math.max(0.0, hv)
                else
                    lo -= 1
                    acc += math.max(0.0, lv)
            pPOC := poc * BIN
            pVAL := lo * BIN
            pVAH := (hi + 1) * BIN
            pdh  := sesHi
            pdl  := sesLo
            // 日線趨勢（只參考）與波動倍數
            array.push(dCloses, sesClose)
            if sesLastI > 209
                array.push(dRanges, sesHi - sesLo)
            pdc := sesClose
            nC = array.size(dCloses)
            if nC >= 25
                s0 = 0.0
                s5 = 0.0
                for k = 0 to 19
                    s0 += array.get(dCloses, nC - 1 - k)
                    s5 += array.get(dCloses, nC - 6 - k)
                s0 := s0 / 20
                s5 := s5 / 20
                lastC = array.get(dCloses, nC - 1)
                dTrend := lastC > s0 and s0 > s5 ? 1 : lastC < s0 and s0 < s5 ? -1 : 0
            nR = array.size(dRanges)
            if nR >= 10
                sr = 0.0
                for k = 0 to 9
                    sr += array.get(dRanges, nR - 1 - k)
                volScale := sr / 10 / 255.2
            map.clear(prof)
            profDate := na
            status := "等待下一個交易日開盤"
            brk := true

        // 累積今天美股盤中的成交量分布
        if rth1 and closed1
            if na(profDate)
                profDate := d1
                sesHi := h1
                sesLo := l1
                sesLastI := i1
            else
                sesHi := math.max(sesHi, h1)
                sesLo := math.min(sesLo, l1)
            sesClose := c1
            sesLastI := i1
            a = int(math.floor(l1 / BIN))
            b = int(math.floor(h1 / BIN))
            nb = b - a + 1
            for k = a to b
                map.put(prof, k, (map.contains(prof, k) ? map.get(prof, k) : 0.0) + v1 / nb)

        // 09:30 開盤：決定方向
        if m1 == 570
            dir := 0
            cnt := 0
            done := false
            sigIdx := na
            v2ok := false
            st := 0
            st2 := 0
            ePx := na
            tp1Px := na
            tp2Px := na
            slPx := na
            res1 := "—"
            res2 := "—"
            i2Pnl := ""
            open930 := o1
            if na(pVAL)
                status := "沒有前一日價值區（換月或資料不足）：今天不做 I2"
            else
                dir := o1 > pVAH ? -1 : o1 < pVAL ? 1 : 0
                status := dir == -1 ? "開盤在 VAH 之上 → 等回到價值區才做空" : dir == 1 ? "開盤在 VAL 之下 → 等回到價值區才做多" : "開盤在價值區內 → 今天不做 I2"
            h1Dist := dir == -1 ? o1 - pVAH : dir == 1 ? pVAL - o1 : na
            h1Ok   := dir != 0 and h1Dist <= pVAH - pVAL
            leanDir := dir == 0 and not na(pPOC) ? (o1 > pPOC ? 1 : o1 < pPOC ? -1 : 0) : 0
            pruneDays(d1)
            // 方向標籤：一行小字；H1 放在提示框；不做的日子不畫（資訊在表格）
            if tfOk and dir != 0
                regL(label.new(bar_index, dir == -1 ? h1 : l1, (dir == 1 ? "等回區才多" : "等回區才空") + (h1Ok ? "" : "・H1 跳過"),
                          color=color.new(color.gray, 25), textcolor=color.white,
                          style=dir == -1 ? label.style_label_down : label.style_label_up, size=size.small,
                          tooltip=(dir == 1 ? "開盤 " + fmt(o1) + " 在 VAL " + fmt(pVAL) + " 之下 → 今天只能做多，而且要等連續 2 根 5 分K 收回價值區" : "開盤 " + fmt(o1) + " 在 VAH " + fmt(pVAH) + " 之上 → 今天只能做空，而且要等連續 2 根 5 分K 收回價值區") +
                                  "\n這不是進場訊號；訊號成立時會另外出現「I2 多／空」標籤" +
                                  "\nH1（研究）：開盤距離 " + fmt(h1Dist) + "／寬度 " + fmt(pVAH - pVAL) + (h1Ok ? " → 會做" : " → 跳過（開太遠）")), d1)
            outside = not na(pdh) and (o1 > pdh or o1 < pdl)
            key = d1 * 10 + 1
            if lastAlertKey < key
                lastAlertKey := key
                alert("NQ 09:30 開盤 " + fmt(o1) + "｜VAL " + fmt(pVAL) + "／VAH " + fmt(pVAH) + "｜" + status +
                      "｜v2 突破共振：" + (outside ? "開在前日範圍外，可做" : "開在前日範圍內，不做") +
                      (dir != 0 ? "｜H1（研究）：開盤距離 " + fmt(h1Dist) + "／寬度 " + fmt(pVAH - pVAL) + (h1Ok ? " → 會做" : " → 跳過") : ""), alert.freq_all)

        // 開盤前提醒：美東 09:00
        if m1 == 540 and closed1
            key = d1 * 10 + 0
            if lastAlertKey < key
                lastAlertKey := key
                pd0 = na(pVAL) ? 0 : c1 > pVAH ? -1 : c1 < pVAL ? 1 : 0
                alert("NQ 開盤前｜今日 I2 價值區 VAL " + fmt(pVAL) + "、POC " + fmt(pPOC) + "、VAH " + fmt(pVAH) +
                      "｜前一日盤中高 " + fmt(pdh) + "、低 " + fmt(pdl) + "｜盤前預判：" +
                      (pd0 == 1 ? "在區下方（開盤後要等回區才做多）" : pd0 == -1 ? "在區上方（開盤後要等回區才做空）" : "在區內（可能不做）") + "，歷史準確率 " + (pd0 == 1 ? "97%" : pd0 == -1 ? "90%" : "86%"), alert.freq_all)

        // 每個完整 5 分K 收盤（09:34、09:39 … 11:29）檢查
        if rth1 and closed1 and dir != 0 and not done and i1 >= 4 and i1 <= 119 and i1 % 5 == 4
            inside = c1 >= pVAL and c1 <= pVAH
            cnt := inside ? cnt + 1 : 0
            if cnt >= 2
                done := true
                ei = i1 + 1
                if (ei >= 28 and ei <= 32) or ei > LAST_V1
                    status := "訊號出現，但進場時間在禁止時段 → 今天取消"
                    key = d1 * 10 + 2
                    if lastAlertKey < key
                        lastAlertKey := key
                        alert("NQ I2：訊號出現在禁止時段（09:58–10:02），今天取消", alert.freq_all)
                else
                    sigIdx := i1
                    st := 1
                    v2ok := ei <= LAST_V2
                    st2 := v2ok ? 1 : 0
                    status := (dir == 1 ? "做多" : "做空") + "訊號成立 → 下一分鐘開盤進場" + (v2ok ? "（v1＋v2）" : "（只有 v1；v2 已過 10:59）")
                    key = d1 * 10 + 3
                    if lastAlertKey < key
                        lastAlertKey := key
                        alert("NQ I2 訊號：" + (dir == 1 ? "做多" : "做空") + "，下一分鐘開盤進場｜止損 145 點、止盈 v1 55 點" +
                              (v2ok ? "／v2 80 點" : "（v2 不做：超過 10:59）") + "｜參考收盤 " + fmt(c1) + "｜H1（研究）：" + (h1Ok ? "會做" : "跳過"), alert.freq_all)

        // 進場那一分鐘：開盤價就是進場價
        if st == 1 and rth1 and i1 == sigIdx + 1
            ePx   := o1
            tp1Px := o1 + dir * TP1
            tp2Px := o1 + dir * TP2
            slPx  := o1 - dir * SL
            st    := 2
            st2   := v2ok ? 2 : 0
            i2InP := (not winMode or dir == 1) and gateWhy() == ""
            if i2InP
                planN += 1
                planOpen += 1
            status := "已進場" + (dir == 1 ? "多" : "空") + "，持倉中"
            key = d1 * 10 + 4
            if lastAlertKey < key
                lastAlertKey := key
                alert("NQ I2 進場 " + (dir == 1 ? "多 " : "空 ") + fmt(ePx) + "｜止損 " + fmt(slPx) + "｜止盈 v1 " + fmt(tp1Px) +
                      (v2ok ? "／v2 " + fmt(tp2Px) : "") + "｜12:29 未結束就出場", alert.freq_all)
            if tfOk
                i2Base := bsTxt(dir == 1, i2InP, "I2 回價值區", ePx, dir == 1 ? "原因：開在價值區下方，2 根 5 分K 收回 VAL " + fmt0(pVAL) + " 之上" : "原因：開在價值區上方，2 根 5 分K 收回 VAH " + fmt0(pVAH) + " 之下")
                i2Lbl := regL(label.new(bar_index, dir == 1 ? l1 : h1, i2Base, color=bsCol(dir == 1, i2InP),
                          textcolor=color.white, style=dir == 1 ? label.style_label_up : label.style_label_down, size=size.small,
                          tooltip="I2 v1（正式在測的規則）\n進場 " + fmt(ePx) + "\n止盈 " + fmt(tp1Px) + "（+55 點）\n止損 " + fmt(slPx) + "（−145 點）\n12:29（美東）未結束就出場"), d1)
                // 止盈／止損區（和參考點同樣的畫法，顏色較深），延伸到出場那根
                i2TpB := regB(box.new(bar_index, math.max(ePx, tp1Px), bar_index, math.min(ePx, tp1Px), border_color=color.new(color.green, 30), bgcolor=color.new(color.green, 75)), d1)
                i2SlB := regB(box.new(bar_index, math.max(ePx, slPx), bar_index, math.min(ePx, slPx), border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 82)), d1)

        // 紙上追蹤結果（同一分鐘同時碰到 → 算停損，和凍結規則一樣保守）
        if rth1 and closed1 and not na(sigIdx) and i1 >= sigIdx + 1
            hitSL = st >= 2 and (dir == 1 ? l1 <= slPx : h1 >= slPx)
            if st == 2
                if tfOk
                    box.set_right(i2TpB, bar_index)
                    box.set_right(i2SlB, bar_index)
                if hitSL
                    st := 3
                    res1 := "止損"
                    i2Pnl := pnlTxt(-SL * 20 - 48)
                else if (dir == 1 ? h1 >= tp1Px : l1 <= tp1Px)
                    st := 3
                    res1 := "止盈"
                    i2Pnl := pnlTxt(TP1 * 20 - 48)
                else if i1 == 179
                    st := 3
                    res1 := "時間到 " + fmt(c1)
                    i2Pnl := pnlTxt(dir * (c1 - ePx) * 20 - 48)
                if st == 3
                    if i2InP
                        planPnl += res1 == "止損" ? -SL * 20 - 48 : res1 == "止盈" ? TP1 * 20 - 48 : dir * (c1 - ePx) * 20 - 48
                        planOpen -= 1
                    if tfOk
                        label.set_text(i2Lbl, i2Base + "\n→ " + (res1 == "止盈" ? "✓ " : res1 == "止損" ? "✗ " : "⏱ ") + res1 + " " + i2Pnl)
                    key = d1 * 10 + 5
                    if lastAlertKey < key
                        lastAlertKey := key
                        alert("NQ I2 v1 結果：" + res1 + "（" + i2Pnl + "）", alert.freq_all)
            if st2 == 2
                if hitSL
                    st2 := 3
                    res2 := "止損"
                else if (dir == 1 ? h1 >= tp2Px : l1 <= tp2Px)
                    st2 := 3
                    res2 := "止盈"
                else if i1 == 179
                    st2 := 3
                    res2 := "時間到 " + fmt(c1)
            if st == 3 and st2 != 2
                status := "今天的 I2 交易已結束"
            else if st == 3 and st2 == 2
                status := "v1 已結束，v2 仍持倉中"

        // 12:29 前一分鐘提醒
        if rth1 and i1 == 178 and (st == 2 or st2 == 2)
            key = d1 * 10 + 6
            if lastAlertKey < key
                lastAlertKey := key
                alert("NQ I2：還有 1 分鐘到 12:29，未結束的單準備出場", alert.freq_all)

        // ---------- 參考點（只顯示，不是規則；歷史表現寫在標籤上） ----------
        if m1 == 570
            dayHi := h1
            dayLo := l1
            for r = 0 to 3
                array.set(refSt, r, 0)
            cSide := 0
            cCnt := 0
            cDone := false
            refCount := 0
            refLast := "—"
        else if rth1 and closed1 and i1 <= 179
            dayHi := math.max(dayHi, h1)
            dayLo := math.min(dayLo, l1)

        // 5 分K 收盤時找訊號（09:34、09:39 … 11:29）
        if showRef and rth1 and closed1 and i1 >= 4 and i1 <= 119 and i1 % 5 == 4
            ei = i1 + 1
            okE = ei >= 5 and ei <= LAST_V1 and not (ei >= 28 and ei <= 32)
            sigs = array.new<int>(0)
            sides = array.new<int>(0)
            if not na(pdh) and array.get(refSt, 0) == 0 and dayHi > pdh and c1 < pdh and okE
                array.push(sigs, 0)
                array.push(sides, -1)
            if not na(pdl) and array.get(refSt, 1) == 0 and dayLo < pdl and c1 > pdl and okE
                array.push(sigs, 1)
                array.push(sides, 1)
            if dir == 0 and not na(pVAL) and not cDone
                if c1 > pVAH
                    cSide := -1
                    cCnt := 0
                else if c1 < pVAL
                    cSide := 1
                    cCnt := 0
                else if cSide != 0
                    cCnt += 1
                    if cCnt >= 2
                        cDone := true
                        if okE and refOn(cSide == -1 ? 2 : 3)
                            array.push(sigs, cSide == -1 ? 2 : 3)
                            array.push(sides, cSide)
            if array.size(sigs) > 0
                for k = 0 to array.size(sigs) - 1
                    r = array.get(sigs, k)
                    array.set(refSt, r, 1)
                    array.set(refSide, r, array.get(sides, k))
                    array.set(refSig, r, i1)

        // 進場、追蹤結果（+55／−145、12:29 出場；同一分鐘兩邊都碰到算止損）
        if rth1
            for r = 0 to 3
                s = array.get(refSt, r)
                sd = array.get(refSide, r)
                if s == 1 and i1 == array.get(refSig, r) + 1
                    array.set(refE, r, o1)
                    array.set(refSt, r, 2)
                    refCount += 1
                    // 盤中順勢：做多時價格在 VWAP 之上、做空時在 VWAP 之下（docs/23：順勢勝率 70～82%、逆勢 59～64%）
                    withTrend = not na(vwPrev) and (sd == 1 ? o1 > vwPrev : o1 < vwPrev)
                    rWhy = withTrend ? gateWhy() : "逆盤中趨勢（價格在 VWAP " + (sd == 1 ? "之下" : "之上") + "）"
                    pin = refInPlan(r) and rWhy == ""
                    array.set(refInP, r, pin)
                    if pin
                        planN += 1
                        planOpen += 1
                    txt = "參考：" + refName(r) + " " + fmt(o1) + (withTrend ? "（順盤中趨勢）" : "（逆盤中趨勢）") + "\n止盈 " + fmt(o1 + sd * TP1) + "／止損 " + fmt(o1 - sd * SL) + "\n" + refHist(r, dir != 0) + planNote(refInPlan(r), pin, rWhy)
                    array.set(refTxt, r, txt)
                    // 標籤只寫幾個字，完整內容放在提示框（滑鼠移上去或點一下才展開）
                    if tfOk
                        array.set(refBase, r, bsTxt(sd == 1, pin, refShort(r), o1, r == 0 ? "原因：強壓力 前日高 " + fmt0(pdh) + " 假突破收回" + (withTrend ? "，價格在 VWAP 之下（順勢）" : "，但價格在 VWAP 之上（逆勢）") :
                                  r == 1 ? "原因：強支撐 前日低 " + fmt0(pdl) + " 破底翻" + (withTrend ? "，價格在 VWAP 之上（順勢）" : "，但價格在 VWAP 之下（逆勢）") : "原因：價值區邊緣回歸"))
                        array.set(refLbl, r, regL(label.new(bar_index, sd == 1 ? l1 : h1, array.get(refBase, r), color=bsCol(sd == 1, pin), textcolor=color.white,
                                  style=sd == 1 ? label.style_label_up : label.style_label_down, size=size.small, tooltip=txt), d1))
                        // 止盈／止損區，延伸到出場那根
                        array.set(refTp, r, regB(box.new(bar_index, math.max(o1, o1 + sd * TP1), bar_index, math.min(o1, o1 + sd * TP1),
                                  border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85)), d1))
                        array.set(refSlB, r, regB(box.new(bar_index, math.max(o1, o1 - sd * SL), bar_index, math.min(o1, o1 - sd * SL),
                                  border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 90)), d1))
                    refLast := refShort(r) + " " + fmt(o1) + " 持倉中"
                    if refAlertDay != d1
                        refAlertDay := d1
                        refAlerted := 0
                    bit = int(math.pow(2, r))
                    if refAlert and int(refAlerted / bit) % 2 == 0
                        refAlerted += bit
                        alert("NQ 參考點（不是規則）：" + refName(r) + " " + fmt(o1) + "｜" + refHist(r, dir != 0), alert.freq_all)
                // 進場那一分鐘也要檢查（和回測一樣）
                if array.get(refSt, r) == 2
                    if tfOk
                        box.set_right(array.get(refTp, r), bar_index)
                        box.set_right(array.get(refSlB, r), bar_index)
                if array.get(refSt, r) == 2 and closed1
                    e = array.get(refE, r)
                    out = ""
                    if (sd == 1 ? l1 <= e - SL : h1 >= e + SL)
                        out := "止損 −$2,948"
                    else if (sd == 1 ? h1 >= e + TP1 : l1 <= e - TP1)
                        out := "止盈 +$1,052"
                    else if i1 == 179
                        out := "時間到 " + str.tostring(sd * (c1 - e) * 20 - 48, "+#,##0;−#,##0")
                    if out != ""
                        array.set(refSt, r, 3)
                        if array.get(refInP, r)
                            planPnl += str.startswith(out, "止損") ? -SL * 20 - 48 : str.startswith(out, "止盈") ? TP1 * 20 - 48 : sd * (c1 - e) * 20 - 48
                            planOpen -= 1
                        if tfOk
                            label.set_text(array.get(refLbl, r), array.get(refBase, r) + resMark(out))
                            label.set_tooltip(array.get(refLbl, r), array.get(refTxt, r) + "\n→ " + out)
                        refLast := refShort(r) + " → " + out

        // 計畫的每日損益：一個交易日從美東 18:00 開始（亞洲盤算在隔天）；只開美股時段的圖則在 09:30 換日
        tdKey = ymdOf(t1 + 21600000)
        if tdKey != planDay
            planDay := tdKey
            planPnl := 0.0
            planN := 0
            planOpen := 0
            asLongTaken := false
        // 夜盤最低（美東 18:00～09:29）
        if closed1 and m1 >= 1080 and onDay != d1
            onDay := d1
            onLo := l1
        else if closed1 and (m1 >= 1080 or m1 < 570) and not na(onLo)
            onLo := math.min(onLo, l1)

        // ---------- 亞洲盤參考點（美東 18:00～02:59）：掃過前一日盤中高／低後，5 分K 收回 → 反向；+55／−145、02:59 出場 ----------
        inAsia = m1 >= 1080 or m1 <= 179
        if asiaOn and closed1 and m1 >= 1080 and asDay != d1
            asDay := d1
            asHi := h1
            asLo := l1
            for r = 0 to 1
                array.set(asSt, r, 0)
            asCount := 0
            asLast := "—"
        else if asiaOn and closed1 and inAsia and not na(asHi)
            asHi := math.max(asHi, h1)
            asLo := math.min(asLo, l1)
        if asiaOn and not na(asHi)
            for r = 0 to 1
                sd = r == 0 ? -1 : 1
                s = array.get(asSt, r)
                // 訊號後的下一根 1 分K 開盤進場
                if s == 1 and t1 > array.get(asSigT, r)
                    array.set(asE, r, o1)
                    array.set(asSt, r, 2)
                    s := 2
                    asCount += 1
                    aWhy = r == 1 and asLongTaken ? "今晚已經有一筆亞洲做多" : gateWhy()
                    pin = asInPlan(r) and aWhy == ""
                    array.set(asInP, r, pin)
                    if pin
                        planN += 1
                        planOpen += 1
                        if r == 1
                            asLongTaken := true
                    txt = "參考（亞洲盤）：" + asName(r) + " " + fmt(o1) + "\n止盈 " + fmt(o1 + sd * TP1) + "／止損 " + fmt(o1 - sd * SL) + "\n美東 02:59（台灣 " + twAt(year(t1, TZ), month(t1, TZ), dayofmonth(t1, TZ), 2, 59) + "）未結束就出場\n" + asHist(r) + planNote(asInPlan(r), pin, aWhy)
                    array.set(asTxt, r, txt)
                    if tfOk
                        array.set(asBase, r, bsTxt(sd == 1, pin, asName(r), o1, r == 0 ? "原因：壓力 前日高 " + fmt0(pdh) + " 亞洲盤假突破收回" : "原因：強支撐 前日低 " + fmt0(pdl) + " 亞洲盤破底翻" + (asiaEs ? "＋ES 同步" : "")))
                        array.set(asLbl, r, regL(label.new(bar_index, sd == 1 ? l1 : h1, array.get(asBase, r), color=bsCol(sd == 1, pin), textcolor=color.white,
                                  style=sd == 1 ? label.style_label_up : label.style_label_down, size=size.small, tooltip=txt), d1))
                        array.set(asTp, r, regB(box.new(bar_index, math.max(o1, o1 + sd * TP1), bar_index, math.min(o1, o1 + sd * TP1),
                                  border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85)), d1))
                        array.set(asSlB, r, regB(box.new(bar_index, math.max(o1, o1 - sd * SL), bar_index, math.min(o1, o1 - sd * SL),
                                  border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 90)), d1))
                    asLast := asName(r) + " " + fmt(o1) + " 持倉中"
                    if refAlert
                        alert("NQ 亞洲盤參考點（不是規則）：" + asName(r) + " " + fmt(o1) + "｜止盈 " + fmt(o1 + sd * TP1) + "／止損 " + fmt(o1 - sd * SL), alert.freq_all)
                // 持倉中：進場那一分鐘也檢查（和回測一樣）；同一分鐘兩邊都碰到算止損
                if s == 2
                    if tfOk
                        box.set_right(array.get(asTp, r), bar_index)
                        box.set_right(array.get(asSlB, r), bar_index)
                    if closed1
                        e = array.get(asE, r)
                        out = ""
                        if (sd == 1 ? l1 <= e - SL : h1 >= e + SL)
                            out := "止損 −$2,948"
                        else if (sd == 1 ? h1 >= e + TP1 : l1 <= e - TP1)
                            out := "止盈 +$1,052"
                        else if m1 >= 179 and m1 < 1080
                            out := "時間到 " + str.tostring(sd * (c1 - e) * 20 - 48, "+#,##0;−#,##0")
                        if out != ""
                            array.set(asSt, r, 3)
                            if array.get(asInP, r)
                                planPnl += str.startswith(out, "止損") ? -SL * 20 - 48 : str.startswith(out, "止盈") ? TP1 * 20 - 48 : sd * (c1 - e) * 20 - 48
                                planOpen -= 1
                            if tfOk
                                label.set_text(array.get(asLbl, r), array.get(asBase, r) + resMark(out))
                                label.set_tooltip(array.get(asLbl, r), array.get(asTxt, r) + "\n→ " + out)
                            asLast := asName(r) + " → " + out
            // 5 分K 收盤（美東 18:04、18:09 … 01:59）找訊號
            if closed1 and m1 % 5 == 4 and (m1 >= 1084 or m1 <= 119)
                if not na(pdh) and array.get(asSt, 0) == 0 and asHi > pdh and c1 < pdh
                    array.set(asSt, 0, 1)
                    array.set(asSigT, 0, t1)
                // NQ 第一次收回時，ES 必須已經（或同一根 5 分K）確認；沒有就今晚不做（和回測定義相同）
                esOk = not asiaEs or (esSigT > 0 and esSigT <= t1)
                if not na(pdl) and array.get(asSt, 1) == 0 and asLo < pdl and c1 > pdl
                    array.set(asSt, 1, esOk ? 1 : 3)
                    array.set(asSigT, 1, t1)
                    if not esOk
                        asLast := "亞洲多：ES 沒有同步，今晚不做"

        // ---------- 新進場點：0 亞洲 VAL 多 ES（美東 18:05～02:00、02:59 出場）、1 早盤夜低多 ES（09:35～11:30、12:29 出場）----------
        if closed1 and m1 >= 1080 and xDay != d1
            xDay := d1
            array.set(xSt, 0, 0)
        if m1 == 570
            array.set(xSt, 1, 0)
        for k = 0 to 1
            s = array.get(xSt, k)
            if s == 1 and t1 > array.get(xSigT, k)
                array.set(xE, k, o1)
                array.set(xSt, k, 2)
                s := 2
                xWhy = k == 0 and asLongTaken ? "今晚已經有一筆亞洲做多" : k == 1 and (na(volScale) or volScale < 1.2) ? "波動不到 1.2 倍" : gateWhy()
                pin = xWhy == ""
                array.set(xInP, k, pin)
                if pin
                    planN += 1
                    planOpen += 1
                    if k == 0
                        asLongTaken := true
                txt = "新進場點：" + xName(k) + " " + fmt(o1) + "\n止盈 " + fmt(o1 + TP1) + "／止損 " + fmt(o1 - SL) + "\n" + (k == 0 ? "美東 02:59" : "美東 12:29") + " 未結束就出場\n" + xHist(k) + planNote(true, pin, xWhy)
                array.set(xTxt, k, txt)
                if tfOk
                    array.set(xBase, k, bsTxt(true, pin, xName(k), o1, k == 0 ? "原因：支撐 VAL " + fmt0(pVAL) + " 亞洲盤破底翻＋ES 同步" : "原因：強支撐 夜盤低 " + fmt0(onLo) + " 破底翻＋ES 同步"))
                    array.set(xLbl, k, regL(label.new(bar_index, l1, array.get(xBase, k), color=bsCol(true, pin), textcolor=color.white,
                              style=label.style_label_up, size=size.small, tooltip=txt), d1))
                    array.set(xTp, k, regB(box.new(bar_index, o1 + TP1, bar_index, o1, border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85)), d1))
                    array.set(xSlB, k, regB(box.new(bar_index, o1, bar_index, o1 - SL, border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 90)), d1))
                xLast := xName(k) + " " + fmt(o1) + " 持倉中"
                if refAlert
                    alert("NQ 新進場點：" + xName(k) + " 做多 " + fmt(o1) + "｜止盈 " + fmt(o1 + TP1) + "／止損 " + fmt(o1 - SL) + (pin ? "｜計畫內" : "｜不做：" + xWhy), alert.freq_all)
            if s == 2
                if tfOk
                    box.set_right(array.get(xTp, k), bar_index)
                    box.set_right(array.get(xSlB, k), bar_index)
                if closed1
                    e = array.get(xE, k)
                    out = ""
                    if l1 <= e - SL
                        out := "止損 −$2,948"
                    else if h1 >= e + TP1
                        out := "止盈 +$1,052"
                    else if (k == 0 and m1 >= 179 and m1 < 1080) or (k == 1 and rth1 and i1 >= 179)
                        out := "時間到 " + str.tostring((c1 - e) * 20 - 48, "+#,##0;−#,##0")
                    if out != ""
                        array.set(xSt, k, 3)
                        if array.get(xInP, k)
                            planPnl += str.startswith(out, "止損") ? -SL * 20 - 48 : str.startswith(out, "止盈") ? TP1 * 20 - 48 : (c1 - e) * 20 - 48
                            planOpen -= 1
                        if tfOk
                            label.set_text(array.get(xLbl, k), array.get(xBase, k) + resMark(out))
                            label.set_tooltip(array.get(xLbl, k), array.get(xTxt, k) + "\n→ " + out)
                        xLast := xName(k) + " → " + out
        // 訊號：NQ 第一次收回時，ES 必須已經（或同一根 5 分K）出現同樣的訊號，否則這次不做（和回測定義相同）
        if closed1 and m1 % 5 == 4 and (m1 >= 1084 or m1 <= 119) and array.get(xSt, 0) == 0 and not na(pVAL) and not na(onLo)
            if onLo < pVAL and c1 > pVAL
                okX = esVaSigT > 0 and esVaSigT <= t1
                array.set(xSt, 0, okX ? 1 : 3)
                array.set(xSigT, 0, t1)
                if not okX
                    xLast := "亞洲 VAL 多：ES 沒有同步，今晚不做"
        eiX = i1 + 1
        if closed1 and rth1 and i1 % 5 == 4 and i1 >= 4 and i1 <= 119 and not (eiX >= 28 and eiX <= 32) and array.get(xSt, 1) == 0 and not na(onLo) and not na(dayLo)
            if dayLo < onLo and c1 > onLo
                okX = esOnSigT > 0 and esOnSigT <= t1
                array.set(xSt, 1, okX ? 1 : 3)
                array.set(xSigT, 1, t1)
                if not okX
                    xLast := "早盤夜低多：ES 沒有同步，今天不做"

        // ---------- 第二層（紙上）：C1、TD10 ----------
        if m1 == 570
            t2St := 0
            c1Done := false
            tdDone := false
            tdPath := 0.0
            tdPrevC := o1
            tdAbove := 0.0
            tdN := 0
            tdPv := 0.0
            tdVv := 0.0
            tdUp := 0
            tdDn := 0
            t2Last := "—"
        // 開盤 30 分鐘（09:30～09:59）的方向效率、在 VWAP 上方的比例
        if rth1 and closed1 and i1 <= 29 and not na(tdPrevC)
            tdPath += math.abs(c1 - tdPrevC)
            tdPrevC := c1
            tdPv += (h1 + l1 + c1) / 3 * v1
            tdVv += v1
            tdAbove += tdVv > 0 and c1 > tdPv / tdVv ? 1.0 : 0.0
            tdN += 1
        a10 = adr10Now()
        // C1：09:34 收盤 − 09:30 開盤 ≥ 0.15×ADR10 → 09:35 順勢
        if showT2 and rth1 and closed1 and i1 == 4 and not c1Done and not na(a10) and not na(open930)
            c1Done := true
            mv = c1 - open930
            if math.abs(mv) >= 0.15 * a10 and mv != 0
                t2St := 1
                t2Dir := mv > 0 ? 1 : -1
                t2Kind := "C1"
                t2Dist := math.min(math.max(0.25 * a10, 10.0), 145.0)
                t2Trail := true
                t2Why := "原因：開盤 5 分鐘" + (mv > 0 ? "上攻 +" : "下殺 −") + fmt0(math.abs(mv)) + " 點 ≥ 0.15×前 10 天振幅（" + fmt0(0.15 * a10) + " 點），順勢"
        // TD10：10:00 第一根（09:55 那根 5 分K 已收），沒有 C1 的日子才做
        if showT2 and rth1 and i1 >= 30 and not tdDone and t2St == 0 and not na(open930)
            tdDone := true
            effi = tdPath > 0 ? (tdPrevC - open930) / tdPath : 0.0
            avw = tdN > 0 ? tdAbove / tdN * 2 - 1 : na
            tdUp := (effi > TD_EFF ? 1 : 0) + (avw > TD_VW ? 1 : 0) + (kSlope > TD_EMA ? 1 : 0) + (kDi > TD_DI ? 1 : 0) + (kMac > TD_MAC ? 1 : 0)
            tdDn := (effi < -TD_EFF ? 1 : 0) + (avw < -TD_VW ? 1 : 0) + (kSlope < -TD_EMA ? 1 : 0) + (kDi < -TD_DI ? 1 : 0) + (kMac < -TD_MAC ? 1 : 0)
            tdDir = tdUp >= 3 and tdDn == 0 ? 1 : tdDn >= 3 and tdUp == 0 ? -1 : 0
            if tdDir != 0
                t2St := 1
                t2Dir := tdDir
                t2Kind := "TD10"
                t2Dist := 100.0
                t2Trail := false
                t2Why := "原因：10:00 趨勢日，" + str.tostring(tdDir == 1 ? tdUp : tdDn) + " 張" + (tdDir == 1 ? "多方" : "空方") + "強票（開盤效率 " + str.tostring(effi, "#.00") + "、VWAP 時間 " + str.tostring(avw, "#.00") + "、EMA 斜率 " + str.tostring(kSlope, "#.0") + "、DI 差 " + str.tostring(kDi, "#") + "、MACD 柱 " + str.tostring(kMac, "#.00") + "）"
                if rth1
                    t2Last := "趨勢日 " + (tdDir == 1 ? "做多" : "做空")
            else
                t2Last := "10:00 判斷：盤整日（多 " + str.tostring(tdUp) + "／空 " + str.tostring(tdDn) + " 票），不做"
        // 進場：C1 在 09:35（訊號後下一根）、TD10 在 10:00 這一根開盤
        if t2St == 1 and rth1 and i1 <= 385 and ((t2Kind == "C1" and i1 >= 5) or (t2Kind == "TD10" and i1 >= 30))
            t2St := 2
            t2E := o1
            t2Stop := o1 - t2Dir * t2Dist
            t2Best := 0.0
            t2Trailed := false
            t2EntryI := i1
            t2Base := "紙上 " + (t2Dir == 1 ? "BUY  " : "SELL  ") + (t2Kind == "C1" ? "開盤動能 C1" : "趨勢日 TD10") + "（5 口 MNQ）\n進 " + fmt(t2E) + "｜SL " + fmt(t2Stop) + (t2Trail ? "｜浮盈 +100 後移動停損 100 點" : "") + "｜15:55 平倉\n" + t2Why
            t2Last := (t2Kind == "C1" ? "C1 " : "TD10 ") + (t2Dir == 1 ? "多 " : "空 ") + fmt(t2E) + " 持倉中"
            if tfOk
                t2Lbl := regL(label.new(bar_index, t2Dir == 1 ? l1 : h1, t2Base, color=color.new(color.blue, 15), textcolor=color.white,
                          style=t2Dir == 1 ? label.style_label_up : label.style_label_down, size=size.small,
                          tooltip=t2Base + "\n第二層只紙上記錄：歷史 C1 每筆 +$489／+$500／+$223（探索／驗證／測試），TD10 +$600／+$203／+$644；紅隊認為證據不夠，累積 40 筆再評估（docs/24）"), d1)
                t2SlB := regB(box.new(bar_index, math.max(t2E, t2Stop), bar_index, math.min(t2E, t2Stop), border_color=color.new(color.blue, 60), bgcolor=color.new(color.blue, 88)), d1)
            if refAlert
                alert("NQ 第二層紙上：" + (t2Kind == "C1" ? "開盤動能 C1 " : "趨勢日 TD10 ") + (t2Dir == 1 ? "做多 " : "做空 ") + fmt(t2E) + "｜SL " + fmt(t2Stop), alert.freq_all)
        // 持倉：先檢查停損（跳空穿過用開盤價），再看 15:55，最後才更新最佳價與移動停損（下一分鐘生效）
        if t2St == 2 and rth1 and closed1
            if tfOk
                box.set_right(t2SlB, bar_index)
            hitS = t2Dir == 1 ? l1 <= t2Stop : h1 >= t2Stop
            out2 = ""
            float xp = na
            if hitS
                gapx = i1 > t2EntryI and (t2Dir == 1 ? o1 < t2Stop : o1 > t2Stop)
                xp := gapx ? o1 : t2Stop
                out2 := t2Trailed ? "移動停損" : "止損"
            else if i1 >= 385
                xp := c1
                out2 := "15:55 平倉"
            if out2 != ""
                t2St := 3
                pnl2 = (t2Dir * (xp - t2E) * 20 - 48) * 0.5
                t2Last := (t2Kind == "C1" ? "C1 " : "TD10 ") + "→ " + out2 + " " + fmt(xp) + "（5 口 MNQ " + pnlTxt(pnl2) + "）"
                if tfOk
                    label.set_text(t2Lbl, t2Base + "\n→ " + out2 + " " + fmt(xp) + "（5 口 MNQ " + pnlTxt(pnl2) + "）")
            else
                fav = t2Dir == 1 ? h1 - t2E : t2E - l1
                t2Best := math.max(t2Best, fav)
                if t2Trail and t2Best >= 100
                    ns = t2E + t2Dir * (t2Best - 100)
                    if (t2Dir == 1 and ns > t2Stop) or (t2Dir == -1 and ns < t2Stop)
                        t2Stop := ns
                        t2Trailed := true

        // 查看過去某一天：在那天 16:00 前存下狀態
        if viewOn and d1 == viewYmd and m1 <= 959
            vVAL := pVAL
            vVAH := pVAH
            vPOC := pPOC
            vPdh := pdh
            vPdl := pdl
            vDir := rth1 ? dir : 0
            vOpen := open930
            vStatus := status
            vE := ePx
            vSl := slPx
            vRes1 := res1
            vRes2 := res2
            vH1 := h1Dist
            vH1Ok := h1Ok
            vLean := leanDir

        // 這一分鐘處理完才更新 VWAP 和暴衝用的收盤序列（下一分鐘進場時用）
        if closed1
            if rth1
                pvSum += (h1 + l1 + c1) / 3 * v1
                vSum += v1
                vwNow := pvSum / vSum
            array.push(recentC, c1)
            if array.size(recentC) > 30
                array.shift(recentC)

// ---------- 盤前預判（只是提示；正式方向以 09:30 開盤價為準） ----------
// 歷史（2024-01～2026-10，683 個可交易日）：美東 09:00 時價格在 VAL 下方 → 97% 開盤也在下方；在 VAH 上方 → 90%；在區內 → 86%。
// 美東 08:00 時判斷：多／空約 84%，區內約 73%。更早只能當參考。
preDir  = na(pVAL) ? 0 : close > pVAH ? -1 : close < pVAL ? 1 : 0
preAcc  = mod >= 540 and mod < 570 ? (preDir == 1 ? "97%" : preDir == -1 ? "90%" : "86%") : mod >= 480 and mod < 570 ? (preDir == 0 ? "73%" : "84%") : "較低（美東 08:00 前，只能參考）"
showDir = isRth ? dir : preDir
// 只有訊號成立（下一分鐘進場）或持倉中才用綠／紅色；其他時候一律灰色，避免看成「現在去做多／空」
live    = isRth and (st == 1 or st == 2)
liveDir = live ? dir : 0
gapPts  = dir == 1 ? pVAL - close : dir == -1 ? close - pVAH : na   // 現價離價值區幾點（正數＝還在區外）
waitTxt(d) => (d == 1 ? "等回區才多" : "等回區才空")

// ---------- 畫圖 ----------
pH = plot(brk ? na : pVAH, "VAH", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
pL = plot(brk ? na : pVAL, "VAL", color=color.new(color.teal, 0), linewidth=2, style=plot.style_linebr)
// 盤中用較明顯的顏色；盤前／夜盤只是預判，顏色很淡，避免整張圖被染色
bandCol = liveDir == 1 ? color.new(color.green, 85) : liveDir == -1 ? color.new(color.red, 85) : color.new(color.gray, isRth ? 90 : 96)
fill(pH, pL, color=bandCol, title="價值區底色（綠／紅＝訊號成立或持倉中、灰＝等待或不做）")
plot(brk ? na : pPOC, "POC", color=color.new(color.gray, 30), linewidth=1, style=plot.style_linebr)
plot(brk ? na : pdh, "前一日盤中高", color=color.new(color.red, 40), linewidth=1, style=plot.style_circles)
plot(brk ? na : pdl, "前一日盤中低", color=color.new(color.green, 40), linewidth=1, style=plot.style_circles)
plot(showVwap and isRth ? vwNow : na, "VWAP（美股盤中）", color=color.new(color.purple, 10), linewidth=1, style=plot.style_linebr)
showLv = isRth and idx <= 179 and (st == 2 or st2 == 2 or st == 3)
// v1 的進場／止盈／止損改成方框（畫在進場那段）；v2 的 +80 止盈仍用虛線，只畫在圖上、不顯示在右側價格刻度
plot(showLv and showV2 and v2ok ? tp2Px : na, "止盈 v2", color=color.new(color.lime, 0), style=plot.style_linebr, display=display.pane)

// 價位線右側的名稱與價格（靠得很近的合併成一個，避免疊字）
var array<label> lvLbls = array.new<label>()
if barstate.islast
    while array.size(lvLbls) > 0
        label.delete(array.pop(lvLbls))
    if tfOk and showLvLbl and not na(pVAL)
        ps = array.from(pVAH, pPOC, pVAL, pdh, pdl)
        ns = array.from("VAH ", "POC ", "VAL ", "前高 ", "前低 ")
        cs = array.from(color.orange, color.gray, color.teal, color.new(color.red, 20), color.new(color.green, 20))
        tol = math.max(4.0, (pVAH - pVAL) * 0.06)
        used = array.new_bool(5, false)
        for i = 0 to 4
            p0 = array.get(ps, i)
            if not array.get(used, i) and not na(p0)
                txt = array.get(ns, i) + fmt0(p0)
                for k = math.min(i + 1, 4) to 4
                    pk = k > i ? array.get(ps, k) : na
                    if not array.get(used, k) and not na(pk) and math.abs(pk - p0) <= tol
                        array.set(used, k, true)
                        txt += "／" + array.get(ns, k) + fmt0(pk)
                array.push(lvLbls, label.new(bar_index + 2, p0, txt, style=label.style_label_left, color=color.new(color.black, 100),
                                             textcolor=array.get(cs, i), size=size.small))
bgcolor(isRth and idx >= 28 and idx <= 32 ? color.new(color.gray, 85) : na, title="09:58–10:02 不進場")
bgcolor(isRth and idx >= 5 and idx <= LAST_V2 ? color.new(color.blue, 95) : isRth and idx > LAST_V2 and idx <= LAST_V1 ? color.new(color.purple, 96) : na, title="進場時段（藍＝v1+v2、紫＝只有 v1）")

tPos = tblPos == "右上" ? position.top_right : tblPos == "左下" ? position.bottom_left : tblPos == "左上" ? position.top_left : position.bottom_right
// 局勢文字（資訊表用）
intraDir = isRth and not na(vwNow) ? (close > vwNow ? 1 : -1) : 0
regimeTxt = "盤中 " + (intraDir == 1 ? "VWAP 之上 → 只做多" : intraDir == -1 ? "VWAP 之下 → 只做空" : "未開盤") +
             "｜日線 " + (dTrend == 1 ? "多頭" : dTrend == -1 ? "空頭" : "盤整") + "（只參考）" +
             "｜夜盤 " + (na(pdc) ? "—" : close > pdc ? "高於前收 " + fmt0(close - pdc) : "低於前收 " + fmt0(pdc - close)) +
             "｜波動 " + (na(volScale) ? "—" : str.tostring(volScale, "#.0") + " 倍")
alertTxt = shockNow >= swanTh ? "暴衝 " + fmt0(shockNow) + " 點：暫停進場" : (not na(volScale) and volScale >= 2.0) ? "高波動 " + str.tostring(volScale, "#.0") + " 倍：口數建議減半" : "正常"
var table t = table.new(tPos, 2, 26, bgcolor=color.new(color.black, 20), border_width=1)

// 精簡模式：三行白話
if tblMode == "精簡" and barstate.islast
    cDir = viewOn ? 0 : liveDir
    cHead = viewOn ? "（" + str.tostring(viewYmd) + "）" + (vDir == 0 ? "不做" : waitTxt(vDir)) :
             isRth ? (dir == 0 ? "不做" : st == 1 ? (dir == 1 ? "做多訊號 ▲ 下一分鐘進場" : "做空訊號 ▼ 下一分鐘進場") :
                      st == 2 ? (dir == 1 ? "持倉中（多）" : "持倉中（空）") : st == 3 ? "今天已結束" :
                      done ? "今天不做（沒有進場機會）" : waitTxt(dir) + (h1Ok ? "" : "｜H1 跳過")) :
             (preDir == 1 ? "盤前：在區下方，開盤後才定" : preDir == -1 ? "盤前：在區上方，開盤後才定" : "盤前：在區內，可能不做")
    cVa = viewOn ? fmt0(vVAL) + " ～ " + fmt0(vVAH) : fmt0(pVAL) + " ～ " + fmt0(pVAH)
    cNext = viewOn ? (na(vE) ? vStatus : "進場 " + fmt(vE) + "｜結果：" + vRes1) :
             not isRth ? "等美股開盤（美東 09:30）才確定方向" :
             dir == 0 ? "今天不交易" + (leanDir == 1 ? "（傾向偏多，把握低）" : leanDir == -1 ? "（傾向偏空，把握很低）" : "") :
             st == 1 ? "訊號成立，下一分鐘進場" :
             st == 2 ? "持倉中｜進場 " + fmt(ePx) + "｜止損 " + fmt(slPx) + "｜止盈 " + fmt(tp1Px) :
             st == 3 ? "已結束：" + res1 + "（" + i2Pnl + "）" :
             done ? "今天已經沒有進場機會" :
             gapPts > 0 ? "還沒有訊號：現價離價值區 " + fmt0(gapPts) + " 點；要連續 2 根 5 分K 收在 " + fmt0(pVAL) + "～" + fmt0(pVAH) + " 才" + (dir == 1 ? "做多" : "做空") :
             "已回到區內：等連續 2 根 5 分K 收在區內才" + (dir == 1 ? "做多" : "做空")
    // 時間列：台灣時間對照（夏令時間自動換算）
    y0 = year(timenow, TZ)
    mo0 = month(timenow, TZ)
    d0 = dayofmonth(timenow, TZ)
    nowM = minOf(timenow)
    left = 570 - nowM
    cTime = nowM < 570 ? "距開盤 " + (left >= 60 ? str.tostring(int(left / 60)) + " 小時 " : "") + str.tostring(left % 60) + " 分（台灣 " + twAt(y0, mo0, d0, 9, 30) + "）" :
             nowM <= 690 ? "可進場到台灣 " + twAt(y0, mo0, d0, 11, 30) + "｜最晚出場 " + twAt(y0, mo0, d0, 12, 29) :
             nowM <= 749 ? "已過進場時間｜最晚出場台灣 " + twAt(y0, mo0, d0, 12, 29) :
             "今天已收工｜下次開盤台灣 " + twAt(y0, mo0, d0, 9, 30)
    table.cell(t, 0, 0, "今天", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, cHead, text_color=color.white, bgcolor=cDir == 1 ? color.new(color.green, 0) : cDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 0), text_size=size.small)
    table.cell(t, 0, 1, "價值區", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, cVa, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "下一步", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, cNext, text_color=color.yellow, text_size=size.small)
    if not viewOn
        table.cell(t, 0, 3, "時間", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 3, cTime, text_color=color.white, text_size=size.small)
    if showRef and not viewOn
        table.cell(t, 0, 4, "參考點", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 4, refCount == 0 ? "今天還沒有" : str.tostring(refCount) + " 個｜" + refLast,
                   text_color=color.silver, text_size=size.small,
                   tooltip="灰色標籤＝參考點，不是規則。滑鼠移到標籤上看進場價、止盈止損與歷史表現。" + (refMode == "全部" ? "" : "\n區邊回歸（歷史每筆為負）預設不顯示，可在設定改成「全部」。"))
    if not tfOk
        table.cell(t, 0, 5, "注意", text_color=color.white, bgcolor=color.new(color.red, 0), text_size=size.normal)
        table.cell(t, 1, 5, "這個週期不畫標籤：請改用 1～15 分K", text_color=color.white, bgcolor=color.new(color.red, 0), text_size=size.normal)
    if not viewOn
        table.cell(t, 0, 7, "計畫", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 7, planShort + "｜今天 " + str.tostring(planN) + " 筆｜已實現 " + pnlTxt(planPnl) + ((planPnl - FULL_SL * (planOpen + 1) < LOSS_CAP) ? "｜再虧一筆會超過 −$3,000，今天不再進場" : ""),
                   text_color=color.white, bgcolor=(planPnl - FULL_SL * (planOpen + 1) < LOSS_CAP) ? color.new(color.red, 30) : color.new(color.gray, 50), text_size=size.small, tooltip=planTxt + "\n彩色標籤＝計畫內的點；灰色＝不在計畫內。每筆 10 口 MNQ，止盈 +$1,052、止損 −$2,948（已扣成本）。")
    if not viewOn
        table.cell(t, 0, 8, "局勢", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 8, regimeTxt, text_color=color.white, bgcolor=intraDir == 1 ? color.new(color.teal, 55) : intraDir == -1 ? color.new(color.maroon, 55) : color.new(color.gray, 60), text_size=size.small,
                   tooltip="盤中（美股）：價格在 VWAP 之上只做多、之下只做空（前高空、前低多照這個過濾）。\n日線趨勢只參考：歷史上順著日線做沒有比較好（docs/23）。\n夜盤：價格相對前一天美股收盤。")
        if showT2
            table.cell(t, 0, 10, "第二層（紙上）", text_color=color.white, text_size=size.small)
            table.cell(t, 1, 10, t2Last, text_color=color.white, bgcolor=color.new(color.blue, 55), text_size=size.small,
                       tooltip="藍色＝第二層，只紙上記錄：09:35 開盤 5 分鐘動能（C1），沒有 C1 才在 10:00 判斷趨勢日（TD10）；5 口 MNQ、15:55 平倉。")
        table.cell(t, 0, 9, "警戒", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 9, alertTxt, text_color=color.white, bgcolor=shockNow >= swanTh ? color.new(color.red, 20) : (not na(volScale) and volScale >= 2.0) ? color.new(color.orange, 30) : color.new(color.gray, 60), text_size=size.small,
                   tooltip="暴衝：最近 30 分鐘內 5 分鐘漲跌 ≥ " + str.tostring(swanTh, "#") + " 點就不進場（歷史上這時進場的單平均虧錢）。\n高波動：前 10 天振幅 ≥ 2 倍時，口數建議減半。\n黑天鵝：所有單都不抱過收盤；停損一定要掛在券商。")
    if asiaOn and not viewOn
        table.cell(t, 0, 6, "亞洲盤", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 6, (asCount == 0 ? "還沒有" : str.tostring(asCount) + " 個｜" + asLast) + "｜進場台灣 " + twAt(y0, mo0, d0, 18, 5) + "～" + twAt(y0, mo0, d0, 2, 0),
                   text_color=color.silver, text_size=size.small,
                   tooltip="亞洲盤參考點：美東 18:00 後價格超過前一日盤中高（低），5 分K 又收回來 → 反向，+55／−145，美東 02:59 出場。\n亞洲多 ES（青綠色）：ES 也同時掃過自己的前日低點並收回，通過事先登記的篩選（docs/21）。\n亞洲空（灰色）：沒通過，只紙上記錄。")

// 完整模式
if tblMode == "完整" and barstate.islast
    dirTxt = isRth ? (dir == 0 ? "今天不做 I2" : st == 1 ? (dir == 1 ? "做多訊號 ▲ 下一分鐘進場" : "做空訊號 ▼ 下一分鐘進場") :
                      st == 2 ? (dir == 1 ? "持倉中（多）" : "持倉中（空）") : st == 3 ? "今天已結束" : done ? "今天不做（沒有進場機會）" : waitTxt(dir)) :
             (preDir == 1 ? "盤前：在區下方，開盤後才定" : preDir == -1 ? "盤前：在區上方，開盤後才定" : "盤前：在區內（可能不做）")
    dirBg  = liveDir == 1 ? color.new(color.green, 0) : liveDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
    whyTxt = isRth ? ("開盤 " + fmt(open930) + (dir == 1 ? " 在 VAL 之下" : dir == -1 ? " 在 VAH 之上" : " 在價值區內")) :
             ("現價 " + fmt(close) + (preDir == 1 ? " 在 VAL 之下" : preDir == -1 ? " 在 VAH 之上" : " 在價值區內") + "｜歷史準確率 " + preAcc)
    nextTxt = showDir == 1 ? "等價格回到 " + fmt(pVAL) + "～" + fmt(pVAH) + "，連續 2 根 5分K 收在區內 → 做多" :
              showDir == -1 ? "等價格回到 " + fmt(pVAL) + "～" + fmt(pVAH) + "，連續 2 根 5分K 收在區內 → 做空" :
              "開盤若仍在區內，今天不做 I2"
    if viewOn
        dirTxt := "（" + str.tostring(viewYmd) + "）" + (vDir == 0 ? "不做 I2" : waitTxt(vDir))
        dirBg  := color.new(color.gray, 0)
        whyTxt := "開盤 " + fmt(vOpen) + (vDir == 1 ? " 在 VAL 之下" : vDir == -1 ? " 在 VAH 之上" : " 在價值區內或無資料")
        nextTxt := "查看過去模式（設定 → 歷史 → 取消勾選就回到即時）"
    table.cell(t, 0, 0, "I2 價值區助手", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, tfOk ? timeframe.period + " 分K 圖 ✓（內部用 1 分K 計算）" : "請改用 15 分K 以下的圖！", text_color=tfOk ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 1, "方向", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, dirTxt, text_color=color.white, bgcolor=dirBg, text_size=size.small)
    table.cell(t, 0, 2, "依據", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, whyTxt, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "下一步", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, nextTxt, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "VAH", text_color=color.orange, text_size=size.small)
    table.cell(t, 1, 4, fmt(viewOn ? vVAH : pVAH), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "POC", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 5, fmt(viewOn ? vPOC : pPOC), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 6, "VAL", text_color=color.teal, text_size=size.small)
    table.cell(t, 1, 6, fmt(viewOn ? vVAL : pVAL), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 7, "前日高／低", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, fmt(viewOn ? vPdh : pdh) + "／" + fmt(viewOn ? vPdl : pdl), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 8, "狀態", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 8, viewOn ? vStatus : status, text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 9, "進場／止損", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 9, na(viewOn ? vE : ePx) ? "—" : fmt(viewOn ? vE : ePx) + "／" + fmt(viewOn ? vSl : slPx), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 10, "結果：規則（+55）", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 10, viewOn ? vRes1 : res1, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 11, "結果：實驗版（+80）", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 11, showV2 ? (viewOn ? vRes2 : res2) : "（隱藏）", text_color=color.white, text_size=size.small)
    // 歷史回測（凍結規則 v1，2024-01～2026-10，stress 成本），只是參考，不保證未來
    if showHist
        table.cell(t, 0, 12, "歷史：只找多", text_color=color.lime, text_size=size.small)
    if showHist
        table.cell(t, 1, 12, "36% 的日子出訊號｜止盈 60%、止損 9%、時間到 31%｜每筆 +$249（68 筆，含前進測試 2 筆）", text_color=color.white, text_size=size.small)
    if showHist
        table.cell(t, 0, 13, "歷史：只找空", text_color=color.red, text_size=size.small)
    if showHist
        table.cell(t, 1, 13, "35% 的日子出訊號｜止盈 62%、止損 10%、時間到 29%｜每筆 +$115（94 筆，含前進測試 1 筆）", text_color=color.white, text_size=size.small)
    preDist = preDir == -1 ? close - pVAH : preDir == 1 ? pVAL - close : na
    h1Txt = viewOn ? (vDir == 0 ? "那天不做 I2" : "開盤距離 " + fmt(vH1) + "／寬度 " + fmt(vVAH - vVAL) + (vH1Ok ? " → 會做" : " → 跳過")) : isRth ? (dir == 0 ? "今天不做 I2，H1 不適用" : "開盤距離 " + fmt(h1Dist) + "／寬度 " + fmt(pVAH - pVAL) + (h1Ok ? " → 會做" : " → 跳過")) :
             (preDir == 0 ? "現價在區內，H1 不適用" : "若現在開盤：距離 " + fmt(preDist) + "／寬度 " + fmt(pVAH - pVAL) + (preDist <= pVAH - pVAL ? " → 會做" : " → 跳過"))
    table.cell(t, 0, 14, "H1（研究）", text_color=color.aqua, text_size=size.small)
    table.cell(t, 1, 14, h1Txt + "｜只記錄，不改規則", text_color=color.white, bgcolor=(viewOn ? (vDir != 0 and vH1Ok) : isRth ? (dir != 0 and h1Ok) : (preDir != 0 and preDist <= pVAH - pVAL)) ? color.new(color.teal, 40) : color.new(color.gray, 60), text_size=size.small)
    if showHist
        table.cell(t, 0, 15, "歷史：H1", text_color=color.aqua, text_size=size.small)
    if showHist
        table.cell(t, 1, 15, "會做 138 筆：止盈 65.2%、每筆 +$227｜跳過 24 筆：止盈 37.5%、每筆 −$148（看過的資料，p=0.14）", text_color=color.white, text_size=size.small)
    lnD = viewOn ? vLean : (isRth ? leanDir : 0)
    lnShow = (viewOn or isRth) and (viewOn ? vDir : dir) == 0
    lnTxt = not lnShow ? "—（只在 I2 不做的日子顯示）" : lnD == 1 ? "偏多 ▲（開盤在 POC 之上）｜歷史 116 筆：止盈 64.7%、每筆 +$133（2024 +$2、2025 +$97、2026 +$376）｜把握低，不是交易訊號" :
             lnD == -1 ? "偏空 ▼（開盤在 POC 之下）｜歷史 113 筆：每筆 −$134（2024、2025 都虧）｜把握很低，不建議" : "—"
    table.cell(t, 0, 16, "低把握傾向", text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 16, lnTxt, text_color=color.white, bgcolor=lnShow and lnD == 1 ? color.new(color.green, 55) : lnShow and lnD == -1 ? color.new(color.red, 60) : color.new(color.gray, 70), text_size=size.small)
    if showRef
        table.cell(t, 0, 17, "參考點", text_color=color.silver, text_size=size.small)
        table.cell(t, 1, 17, (viewOn ? "看圖上灰色標籤" : refCount == 0 ? "今天還沒有" : str.tostring(refCount) + " 個｜最近：" + refLast) +
                   "｜前高假突破空、前低假突破多、區邊回歸（只在開在區內的日子）；+55／−145、12:29 出場；不是規則，歷史表現寫在標籤上",
                   text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(t, 0, 20, "局勢", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 20, regimeTxt, text_color=color.white, bgcolor=intraDir == 1 ? color.new(color.teal, 55) : intraDir == -1 ? color.new(color.maroon, 55) : color.new(color.gray, 60), text_size=size.small)
    table.cell(t, 0, 21, "警戒", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 21, alertTxt, text_color=color.white, bgcolor=shockNow >= swanTh ? color.new(color.red, 20) : (not na(volScale) and volScale >= 2.0) ? color.new(color.orange, 30) : color.new(color.gray, 60), text_size=size.small)
    if showT2
        table.cell(t, 0, 23, "第二層（紙上）", text_color=color.white, text_size=size.small)
        table.cell(t, 1, 23, t2Last + "｜開盤動能 C1，否則 10:00 趨勢日 TD10；5 口 MNQ；只紙上記錄", text_color=color.white, bgcolor=color.new(color.blue, 55), text_size=size.small)
    table.cell(t, 0, 22, "新進場點", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 22, xLast + "｜亞洲 VAL 多 ES、早盤夜低多 ES（ES 同步才做）", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(t, 0, 19, "計畫", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 19, (viewOn ? "（查看過去模式不計算）" : "今天 " + str.tostring(planN) + " 筆｜已實現 " + pnlTxt(planPnl) + ((planPnl - FULL_SL * (planOpen + 1) < LOSS_CAP) ? "｜再虧一筆會超過 −$3,000" : "")) + "｜" + planTxt,
               text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    if asiaOn
        table.cell(t, 0, 18, "亞洲盤", text_color=color.silver, text_size=size.small)
        table.cell(t, 1, 18, (viewOn ? "看圖上灰色標籤" : asCount == 0 ? "還沒有" : str.tostring(asCount) + " 個｜最近：" + asLast) +
                   "｜美東 18:05～02:00 進場、02:59 出場；掃過前日高／低後 5 分K 收回 → 反向；+55／−145；亞洲多 ES（ES 同步）通過篩選，亞洲空只紙上記錄",
                   text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
