//@version=5
// NQ I2 價值區助手（H1 研究版，任意週期）：凍結規則 v1／v2 的看盤輔助，另外顯示 H1 與低把握傾向（只供研究，不改規則）
// 研究用，不是投資建議；只畫線與發警報，不下單、不改規則。
// 圖表可以用 1／5／15 分K；指標內部一律用 1 分K 資料逐分鐘計算（request.security_lower_tf），結果和 1 分K 版相同。
// v11：超過 15 分K（例如日線）不畫標籤和方框；只保留最近幾個交易日的標籤；方向標籤縮成一行、不做的日子不畫。
// v12：沒有訊號時一律灰色，寫「等回區才多／空」並顯示離價值區幾點；只有訊號成立或持倉中才用綠／紅色。
// v13：新增亞洲盤參考點（美東 18:05～02:00 進場、02:59 出場；台灣在美國冬令時 07:05～15:59、夏令時 06:05～14:59）：掃過前一日盤中高／低後 5 分K 收回 → 反向。只顯示，不是規則。
// v15：「進場點模式」：計畫內的點用彩色標籤，資訊表顯示今天筆數、已實現損益和每日停損 −$3,000。
// v18：第二層「紙上」訊號（藍色）：開盤 5 分鐘動能 C1，沒有 C1 才看 10:00 趨勢日 TD10；5 分K 由 1 分K 組成，EMA／ATR／DI／MACD 逐根遞迴（docs/24）。前 10 天振幅只算正常交易日（排除假日半天）。
// v17：局勢判斷（日線趨勢只參考、盤中 VWAP、夜盤相對前收、波動倍數）；前高空／前低多只在順盤中趨勢時算計畫內；新增亞洲 VAL 多 ES、早盤夜低多 ES；最近 30 分鐘 5 分鐘波動 ≥ 250 點暫停進場；下單前檢查「今天再虧一筆會不會超過 −$3,000」。docs/23。
// v16：模式改成三種（docs/21 第 9 節，450 種組合裡四段都賺的 158 種）：推薦（勝率 ≥70% 裡獲利最高：I2＋前高空＋前低多順 I2＋亞洲多 ES）、總獲利最高（再加亞洲空）、勝率最高（只有亞洲多 ES）。前低多只在「只找多」或開在區內的日子算計畫內。
// v14：亞洲多加上 ES 同步確認（ES 也掃過自己的前日低點並收回，不晚於 NQ 那根 5 分K）；這個版本通過事先登記的篩選，標籤改成青綠色「亞洲多 ES」。
// 使用方式：NQ 單一合約（例如 NQZ2026），建議開「延長交易時段」。換月當天不要用（凍結規則當天不做 I2）。
indicator("NQ I2 價值區助手（H1 研究版）", shorttitle="I2 VA H1", overlay=true, max_labels_count=500, max_boxes_count=500)

// ---------- 固定參數（凍結，不要改） ----------
TZ        = "America/New_York"
BIN       = 5.0     // 價格格寬（點）
VA_FRAC   = 0.70    // 價值區涵蓋成交量比例
TP1       = 55.0    // v1 止盈點數
TP2       = 80.0    // v2 I2 止盈點數
SL        = 145.0   // 止損點數
LAST_V1   = 120     // v1 最晚進場：09:30 起第 120 分鐘＝11:30
LAST_V2   = 89      // v2 最晚進場：第 89 分鐘＝10:59

showV2    = input.bool(true, "顯示 v2（11:00 前進場、止盈 +80 點）")
tblMode   = input.string("精簡", "資訊表", options=["精簡", "完整", "關閉"])
tblPos    = input.string("右下", "資訊表位置", options=["右下", "右上", "左下", "左上"])
showTable = tblMode != "關閉"
showHist  = input.bool(false, "資訊表顯示歷史統計")
viewOn    = input.bool(false, "查看過去某一天", group="歷史")
viewT     = input.time(timestamp("2026-10-21T00:00:00"), "日期", group="歷史")
showLvLbl = input.bool(true, "價位線右側標示名稱與價格")
keepDays  = input.int(3, "圖上標籤保留最近幾個交易日", minval=1, maxval=30)
refMode   = input.string("只顯示歷史為正", "參考點（不是規則）", options=["只顯示歷史為正", "全部", "關閉"], group="參考點")
refAlert  = input.bool(false, "參考點也發警報", group="參考點")
asiaOn    = input.bool(true, "亞洲盤參考點（台灣早上；需要開延長交易時段）", group="參考點")
asiaEs    = input.bool(true, "亞洲多：要 ES 同步確認（通過驗證的版本）", group="參考點")
esSym     = input.symbol("CME_MINI:ESZ2026", "ES 合約（和 NQ 同月份）", group="參考點")
planMode  = input.string("順勢多點（預設）", "進場點模式", options=["順勢多點（預設）", "高勝率（只做多）"], group="進場計畫")
winMode   = str.startswith(planMode, "高勝率")
swanTh    = input.float(250.0, "暴衝暫停：最近 30 分鐘內 5 分鐘波動 ≥（點）", group="進場計畫")
showVwap  = input.bool(true, "畫 VWAP（美股盤中）", group="進場計畫")
showT2    = input.bool(true, "顯示第二層紙上訊號（開盤動能 C1／趨勢日 TD10）", group="進場計畫")
showRef   = refMode != "關閉"
refOn(r) => refMode == "全部" or r <= 1   // 區邊回歸（r2、r3）歷史每筆為負，預設不顯示

fmt(x) => str.tostring(x, "#,##0.00")
fmt0(x) => str.tostring(x, "#,##0")
twAt(y, mo, d, hh, mm) => str.format_time(timestamp("America/New_York", y, mo, d, hh, mm), "HH:mm", "Asia/Taipei")   // 美東某時刻換成台灣時間
minOf(t) => hour(t, TZ) * 60 + minute(t, TZ)
ymdOf(t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

// 圖表K棒本身的時間（只用來畫背景、判斷盤前／盤中）
mod   = minOf(time)
isRth = mod >= 570 and mod <= 959
idx   = mod - 570
viewYmd = year(viewT, "Asia/Taipei") * 10000 + month(viewT, "Asia/Taipei") * 100 + dayofmonth(viewT, "Asia/Taipei")
tfOk  = timeframe.isminutes and timeframe.multiplier <= 15   // 只有 1～15 分K 才畫標籤和方框

// 這根圖表K棒裡面的每一根 1 分K
[aT, aO, aH, aL, aC, aV] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, high, low, close, volume])

// ---------- 狀態 ----------
